        "4f5dcee6-e88b-45b6-8aec-c52c786f536c",
        "23c1e82b-c7b6-42da-ad55-eba76922550e"
      ],
      "settings": {
        "output_path": "${KIPRJMOD}"
      },
      "type": "folder"
    }
  ]
}
