{
  "jobs": [
    {
      "id": "c27813d6-92a5-44cf-80eb-1cc074884c35",
      "settings": {
        "check_zones": true,
        "create_gerber_job_file": true,
        "include_netlist_attributes": true,
        "layers": [
          "F.Cu", "In1.Cu", "In2.Cu", "In3.Cu", "In4.Cu", "In5.Cu", "In6.Cu", "In7.Cu", "In8.Cu",
          "In9.Cu", "In10.Cu", "In11.Cu", "In12.Cu", "In13.Cu", "In14.Cu", "In15.Cu", "In16.Cu",
          "In17.Cu", "In18.Cu", "In19.Cu", "In20.Cu", "In21.Cu", "In22.Cu", "In23.Cu", "In24.Cu",
          "In25.Cu", "In26.Cu", "In27.Cu", "In28.Cu", "In29.Cu", "In30.Cu", "B.Cu",
          "F.Mask", "B.Mask", "F.Paste", "B.Paste", "F.SilkS", "B.SilkS", "Edge.Cuts"
        ],
        "plot_drawing_sheet": false,
        "precision": 6,
        "subtract_solder_mask_from_silk": false,
        "use_drill_origin": false,
        "use_protel_file_extension": false,
        "use_x2_format": true
      },
      "type": "pcb_export_gerbers"
    },
    {
      "id": "cabf272b-8730-4276-8518-f96de3124510",
      "settings": {
        "drill_origin": "abs",
        "excellon.combine_pth_npth": false,
        "format": "excellon",
        "units": "mm",
        "zero_format": "decimal"
      },
      "type": "pcb_export_drill"
    },
    {
      "id": "4f5dcee6-e88b-45b6-8aec-c52c786f536c",
      "settings": {
        "black_and_white": false,
        "color_theme": "KiCad Classic",
        "format": "pdf",
        "min_pen_width": 847,
        "output_filename": "${PROJECTNAME}_schematic.pdf",
        "page_size": "auto",
        "pdf_hierarchical_links": true,
        "pdf_metadata": true,
        "pdf_property_popups": true,
        "plot_all": true,
        "plot_drawing_sheet": true,
        "show_hop_over": false,
        "use_background_color": true
      },
      "type": "sch_export_plot_pdf"
    },
    {
      "id": "23c1e82b-c7b6-42da-ad55-eba76922550e",
      "settings": {
        "bom_format_preset_name": "CSV",
        "fields_group_by": ["Value", "Footprint", "${DNP}", "Purchase-URL"],
        "fields_labels": ["Reference", "Qty", "Value", "Footprint", "DNP", "Purchase-URL"],
        "fields_ordered": ["Reference", "${QUANTITY}", "Value", "Footprint", "${DNP}", "Purchase-URL"],
        "group_symbols": true,
        "output_filename": "${PROJECTNAME}_bom.csv",
        "sort_field": "Reference"
      },
      "type": "sch_export_bom"
    }
  ],
  "meta": {
    "version": 1
  },
  "outputs": [
    {
      "description": "Gerbers and drill files",
      "id": "d4356873-f1a8-48e5-92e7-4fa93803a2d6",
      "only": [
        "c27813d6-92a5-44cf-80eb-1cc074884c35",
        "cabf272b-8730-4276-8518-f96de3124510"
      ],
      "settings": {
        "output_path": "${KIPRJMOD}/${PROJECTNAME}_gerbers.zip"
      },
      "type": "archive"
    },
    {
      "description": "Schematic and BOM",
      "id": "b49aed7c-950b-40d2-b312-93641c6f442e",
