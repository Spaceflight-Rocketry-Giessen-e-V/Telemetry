# Python
.venv/
__pycache__/
*.py[cod]

# openEMS / FDTD run output (regenerable)
RHCP_Patch_*/
sim_data/
*.h5
*.vtk

# Plots / logs / generated exports
images/
graphs/
*.log
rhcp_patch_init.xml
geometry_*.xml
patch_antenna*.kicad_pcb
# board_sweep_results.json: regenerable from tests/board_sweep.py; the curve lives in docs/research.md
board_sweep_results.json
# eps_sweep_results.json: regenerable from tests/tool_eps_sweep.py (εr/thickness robustness)
eps_sweep_results.json
# trunc_bw_sweep / thermal_drift results: regenerable from the matching tests/tool_*.py
trunc_bw_sweep*.json
thermal_drift_results.json
# casing print mesh: large binary, regenerable from casing/enclosure.py (openscad). Source +
# the small acrylic-cut DXF + review PNGs ARE tracked; the STL is built on demand.
casing/*.stl

# Gerber / fab exports (regenerable from the .kicad_pcb)
GRBR/
*.zip

# Diagnostic scratch outputs (test harness stdout redirects, e.g. foo > x_out.txt)
*_out*.txt

# Local editor / MCP server config — machine-specific (absolute .vscode paths etc.)
.mcp.json

# Claude Code session artifacts (workflow scripts, transcripts)
.claude/

# Reference papers / notebooks kept locally in docs/ (not tracked)
docs/*.pdf
docs/papers/
