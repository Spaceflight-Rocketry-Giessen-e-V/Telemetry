static const uint16_t FLIGHT_LEN = sizeof(FLIGHT) / sizeof(FLIGHT[0]);

// ---- State ----------------------------------------------------------
bool          armed        = false;
uint16_t      pkt_index    = 0;
unsigned long next_send_ms = 0;

// ---- Helper: load a packet from PROGMEM ----------------------------
TelemetryPacket load_packet(uint16_t idx) {
  TelemetryPacket p;
  memcpy_P(&p, &FLIGHT[idx], sizeof(TelemetryPacket));
  return p;
}

// ---- Helper: send one packet on Serial ------------------------------
void send_packet(const TelemetryPacket& p) {
  Serial.print(F("temperature > 80 C: "));      Serial.println(p.temperature);
  Serial.print(F("subsystem_status: "));        Serial.println(p.subsystem_status);
  Serial.print(F("flight_mode: "));             Serial.println(p.flight_mode);
  Serial.print(F("low_power_mode: "));          Serial.println(p.low_power_mode);
  Serial.print(F("status_events: "));           Serial.println(p.status_events);
  Serial.print(F("acceleration: "));            Serial.println(p.acceleration, 4);
  Serial.print(F("height_pressure: "));         Serial.println(p.height_pressure);
  Serial.print(F("height_gnss: "));             Serial.println(p.height_gnss);
  Serial.print(F("lat_gnss: "));                Serial.println(p.lat_gnss, 7);
  Serial.print(F("lon_gnss: "));                Serial.println(p.lon_gnss, 7);
  Serial.print(F("battery_voltage: "));         Serial.println(p.battery_voltage);
  Serial.print(F("rssi: "));                    Serial.println(p.rssi);
  Serial.print(F("time_since_last_packet: "));  Serial.println(p.time_since_last_packet);
}

// ---- Command normalizer --------------------------------------------
char normalize_cmd(char c) {
  return (c >= 'A' && c <= 'Z') ? c + 32 : c;
}

// ---- Arduino entry points ------------------------------------------
void setup() {
  Serial.begin(115200);
}

void loop() {
  unsigned long now = millis();

  // --- Command parser ---
  while (Serial.available()) {
    char cmd = normalize_cmd(Serial.read());
    switch (cmd) {

      case 'f':   // ARM — begin flight playback
        armed        = true;
        pkt_index    = 0;
        next_send_ms = now;
        break;

      case 'g':   // DISARM — stop playback, wait for next ARM
        armed     = false;
        pkt_index = 0;
        break;

      case 'p': { // force-print current packet immediately
        if (armed && pkt_index < FLIGHT_LEN) {
          send_packet(load_packet(pkt_index));
        }
        break;
      }

      default:
        break;
    }
  }

  // --- Scheduled packet send ---
  if (armed && (long)(now - next_send_ms) >= 0) {
    if (pkt_index < FLIGHT_LEN) {
      TelemetryPacket p = load_packet(pkt_index);
      send_packet(p);
      next_send_ms = now + p.delay_ms;
      pkt_index++;
    } else {
      // Flight finished — disarm and wait
      armed     = false;
      pkt_index = 0;
    }
  }
}
